# SQLite by default; the compose stack overrides this with Postgres.
DATABASE_URL=sqlite:///./eex.db

# Change this before any real deployment.
JWT_SECRET=change-me-in-production-eex-iran
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Populate the demo portfolio on first boot.
SEED_ON_STARTUP=true
