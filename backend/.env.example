# Local development (uvicorn without Docker). Copy to backend/.env.

# development enables /docs and allows running without a JWT secret (a random
# per-process secret is generated, so tokens expire on every restart).
ENVIRONMENT=development

# SQLite by default; the compose stack overrides this with Postgres.
DATABASE_URL=sqlite:///./eex.db

# Required outside development: at least 32 random characters (openssl rand -hex 32).
JWT_SECRET=
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Populate the demo portfolio and demo users (password demo1234) on first boot.
# Local demos only.
SEED_ON_STARTUP=true
