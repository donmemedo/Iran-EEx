# Base URL of the FastAPI backend, as reached from the browser.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Show the demo account panel (and prefill its credentials) on the login page.
# Only works when the backend seeds demo users (SEED_ON_STARTUP=true).
# Keep this false in production. Baked in at build time.
NEXT_PUBLIC_DEMO_MODE=false
