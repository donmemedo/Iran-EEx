# Copy to .env and fill in the two secrets before `docker compose up`.
# Compose refuses to start while JWT_SECRET or POSTGRES_PASSWORD is empty.

# --- Postgres ---------------------------------------------------------------
POSTGRES_USER=eex
# Generate one with: openssl rand -hex 24
POSTGRES_PASSWORD=
POSTGRES_DB=eex

# --- API --------------------------------------------------------------------
ENVIRONMENT=production
# At least 32 random characters. Generate one with: openssl rand -hex 32
JWT_SECRET=
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Demo ---------------------------------------------------------------------
# For a local demo set both to true: the API seeds a sample portfolio and demo
# users whose password is public, and the login page shows those credentials.
# Never enable them on a deployment that holds real data.
SEED_ON_STARTUP=false
NEXT_PUBLIC_DEMO_MODE=false

# --- Ports ------------------------------------------------------------------
BACKEND_PORT=8000
FRONTEND_PORT=3000

# The API URL the browser will call. Baked into the frontend at build time,
# so change it and rebuild if you serve the stack from another host.
NEXT_PUBLIC_API_URL=http://localhost:8000
