# Copy to .env and adjust before running `docker compose up`.

# --- Postgres ---------------------------------------------------------------
POSTGRES_USER=eex
POSTGRES_PASSWORD=eex_dev_password
POSTGRES_DB=eex

# --- API --------------------------------------------------------------------
# Generate one with: openssl rand -hex 32
JWT_SECRET=change-me-in-production-eex-iran
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SEED_ON_STARTUP=true

# --- Ports ------------------------------------------------------------------
BACKEND_PORT=8000
FRONTEND_PORT=3000

# The API URL the browser will call. Baked into the frontend at build time,
# so change it and rebuild if you serve the stack from another host.
NEXT_PUBLIC_API_URL=http://localhost:8000
